# Add this value in Vercel Project Settings → Environment Variables before deployment.
SMTP_PASSWORD=replace-with-the-sales-mailbox-password

# Optional; defaults to the hardcoded sales@eurodigi.ai mailbox.
SMTP_USER=sales@eurodigi.ai

# Optional GoHighLevel CRM synchronisation.
GHL_PRIVATE_INTEGRATION_TOKEN=replace-with-your-private-integration-token
